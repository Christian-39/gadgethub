
---

## 🔐 `.env.example`

```bash
# =============================================================================
# DJANGO CORE
# =============================================================================
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=gadgethub-api.onrender.com,localhost,127.0.0.1

# =============================================================================
# DATABASE (MySQL)
# =============================================================================
DB_NAME=gadgethub
DB_USER=gadgethub
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=3306

# =============================================================================
# PAYUEE API (Required for all commerce operations)
# =============================================================================
PAYUEE_API_KEY=payuee_pk_live_xxxxxxxxxxxxxxxx
PAYUEE_API_SECRET=payuee_sk_live_xxxxxxxxxxxxxxxx
PAYUEE_BASE_URL=https://escrow.payuee.com/v1

# Webhook configuration - must match Payuee Dashboard
WEBHOOK_SECRET=whsec_your_webhook_secret_here
PAYUEE_WEBHOOK_URL=https://gadgethub-api.onrender.com/api/webhooks/payuee/

# =============================================================================
# BACKBLAZE B2 (Media Storage)
# =============================================================================
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=gadgethub-media
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_REGION=us-west-000
USE_S3=True

# =============================================================================
# REDIS (Caching & Sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CORS / CSRF (Must match your frontend Vercel URL exactly)
# =============================================================================
CORS_ALLOWED_ORIGINS=https://gadgethub.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://gadgethub.vercel.app,http://localhost:3000